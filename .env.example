# Set only after the final domain and publication are approved.
SITE_URL=
SITE_INDEXABLE=false

# Run npm run admin:setup to generate local-only values.
# Production: use a stable random secret and persistent PostgreSQL.
PAYLOAD_SECRET=
DATABASE_URI=
# Production HTTPS origin for the workspace (independent of the final SEO domain).
ADMIN_SERVER_URL=
# Optional: disable collection while retaining the dashboard.
ANALYTICS_ENABLED=true
# Production editorial assets only. Provision through Vercel Blob.
BLOB_READ_WRITE_TOKEN=
